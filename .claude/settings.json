{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "R=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; G=\"$R/scripts/hooks/review_round_guard.py\"; if [ -z \"$R\" ] || [ ! -f \"$G\" ] || ! command -v python3 >/dev/null 2>&1; then echo 'Review admission guard unavailable; dispatch denied' >&2; exit 2; fi; python3 \"$G\" || exit 2",
            "timeout": 30,
            "statusMessage": "自己レビューの通算巡数と継続承認を確認"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "R=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; [ -n \"$R\" ] && [ -f \"$R/scripts/hooks/gh_metadata_guard.py\" ] && exec python3 \"$R/scripts/hooks/gh_metadata_guard.py\" || exit 0",
            "timeout": 30,
            "statusMessage": "gh の必須 metadata を確認"
          },
          {
            "type": "command",
            "command": "R=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; [ -n \"$R\" ] && [ -f \"$R/scripts/hooks/coderabbit_gate.py\" ] && exec python3 \"$R/scripts/hooks/coderabbit_gate.py\" || exit 0",
            "timeout": 30,
            "statusMessage": "CodeRabbit への review 依頼を確認"
          },
          {
            "type": "command",
            "command": "R=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; [ -n \"$R\" ] && [ -f \"$R/scripts/hooks/branch_base_guard.py\" ] && exec python3 \"$R/scripts/hooks/branch_base_guard.py\" || exit 0",
            "timeout": 90,
            "statusMessage": "branch の基点を確認"
          },
          {
            "type": "command",
            "command": "R=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; [ -n \"$R\" ] && [ -f \"$R/scripts/hooks/push_gate.py\" ] && exec python3 \"$R/scripts/hooks/push_gate.py\" || exit 0",
            "timeout": 150,
            "statusMessage": "develop への直接 push を gate で確認"
          },
          {
            "type": "command",
            "command": "R=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; [ -n \"$R\" ] && [ -f \"$R/scripts/hooks/truncation_guard.py\" ] && exec python3 \"$R/scripts/hooks/truncation_guard.py\" || exit 0",
            "timeout": 30,
            "statusMessage": "列挙 command の切り詰めを確認"
          },
          {
            "type": "command",
            "command": "R=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; [ -n \"$R\" ] && [ -f \"$R/scripts/hooks/worktree_guard.py\" ] && exec python3 \"$R/scripts/hooks/worktree_guard.py\" || exit 0",
            "timeout": 30,
            "statusMessage": "未 commit の変更を失う git 操作を確認"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "R=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; [ -n \"$R\" ] && [ -f \"$R/scripts/hooks/stop_claim_guard.py\" ] && exec python3 \"$R/scripts/hooks/stop_claim_guard.py\" || exit 0",
            "timeout": 30,
            "statusMessage": "完了の主張とtool呼び出しを確認"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "R=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; [ -n \"$R\" ] && [ -f \"$R/scripts/hooks/merge_trailer_report.py\" ] && exec python3 \"$R/scripts/hooks/merge_trailer_report.py\" || exit 0",
            "timeout": 60,
            "statusMessage": "merge 後の trailer を確認"
          }
        ]
      }
    ]
  }
}
