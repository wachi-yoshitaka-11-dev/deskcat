{
  "fixture_schema": 1,
  "cases": [
    {
      "name": "not_json",
      "line": "this is not json\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "top_level_array",
      "line": "[1,2,3]\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "top_level_string",
      "line": "\"boot\"\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "payload_is_null",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"ping\",\"payload\":null}\n",
      "expect_error": "invalid_envelope",
      "note": "§3: 空のpayloadは`null`ではなく`{}`とする。"
    },
    {
      "name": "payload_is_number",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"ping\",\"payload\":7}\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "missing_envelope_v",
      "line": "{\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"boot\",\"payload\":{\"firmware\":\"0.1.0\",\"board\":\"esp32\",\"reset_reason\":\"power_on\"}}\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "missing_envelope_sid",
      "line": "{\"v\":1,\"id\":1,\"ts_ms\":100,\"type\":\"boot\",\"payload\":{\"firmware\":\"0.1.0\",\"board\":\"esp32\",\"reset_reason\":\"power_on\"}}\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "missing_envelope_id",
      "line": "{\"v\":1,\"sid\":41207,\"ts_ms\":100,\"type\":\"boot\",\"payload\":{\"firmware\":\"0.1.0\",\"board\":\"esp32\",\"reset_reason\":\"power_on\"}}\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "missing_envelope_ts_ms",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"type\":\"boot\",\"payload\":{\"firmware\":\"0.1.0\",\"board\":\"esp32\",\"reset_reason\":\"power_on\"}}\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "missing_envelope_type",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"payload\":{\"firmware\":\"0.1.0\",\"board\":\"esp32\",\"reset_reason\":\"power_on\"}}\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "missing_envelope_payload",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"boot\"}\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "envelope_v_wrong_type",
      "line": "{\"v\":\"1\",\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"boot\",\"payload\":{\"firmware\":\"0.1.0\",\"board\":\"esp32\",\"reset_reason\":\"power_on\"}}\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "envelope_sid_negative",
      "line": "{\"v\":1,\"sid\":-1,\"id\":1,\"ts_ms\":100,\"type\":\"ping\",\"payload\":{}}\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "envelope_sid_above_u32",
      "line": "{\"v\":1,\"sid\":4294967296,\"id\":1,\"ts_ms\":100,\"type\":\"ping\",\"payload\":{}}\n",
      "expect_error": "invalid_envelope",
      "note": "宣言した幅に収まらない値はenvelopeとして復元できない。"
    },
    {
      "name": "envelope_ts_ms_above_u64",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"ts_ms\":18446744073709551616,\"type\":\"ping\",\"payload\":{}}\n",
      "expect_error": "invalid_envelope"
    },
    {
      "name": "unsupported_major_version",
      "line": "{\"v\":2,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"ping\",\"payload\":{}}\n",
      "expect_error": "unsupported_version"
    },
    {
      "name": "unknown_message_type",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"motion_completed\",\"payload\":{\"name\":\"nod\"}}\n",
      "expect_error": "unknown_type",
      "note": "今回型を起こさないtype（§4.7。PROTO-TBD-008）。motion_completedの型を足すときは、このcaseのtypeを差し替える。unknown_typeではpayloadを解釈しないため、payloadの形は§4.7由来ではなく任意である。"
    },
    {
      "name": "play_motion_missing_name",
      "line": "{\"v\":1,\"sid\":41207,\"id\":30,\"ts_ms\":100,\"type\":\"play_motion\",\"payload\":{\"speed\":0.45,\"repeat\":1}}\n",
      "expect_error": "invalid_payload",
      "note": "`name`は必須である（§3）。"
    },
    {
      "name": "play_motion_missing_speed",
      "line": "{\"v\":1,\"sid\":41207,\"id\":31,\"ts_ms\":100,\"type\":\"play_motion\",\"payload\":{\"name\":\"nod\",\"repeat\":1}}\n",
      "expect_error": "invalid_payload",
      "note": "`speed`は必須である（§3）。省略を許すのは意味が決まってからにする。"
    },
    {
      "name": "play_motion_missing_repeat",
      "line": "{\"v\":1,\"sid\":41207,\"id\":32,\"ts_ms\":100,\"type\":\"play_motion\",\"payload\":{\"name\":\"nod\",\"speed\":0.45}}\n",
      "expect_error": "invalid_payload",
      "note": "`repeat`は必須である（§3）。"
    },
    {
      "name": "play_motion_speed_not_finite",
      "line": "{\"v\":1,\"sid\":41207,\"id\":33,\"ts_ms\":100,\"type\":\"play_motion\",\"payload\":{\"name\":\"nod\",\"speed\":1e39,\"repeat\":1}}\n",
      "expect_error": "invalid_payload",
      "note": "`speed`は有限の32-bit浮動小数点数である（§3）。32-bitへ狭めた結果が有限でない数（例: 1e39）は拒否する。"
    },
    {
      "name": "play_motion_speed_not_a_number",
      "line": "{\"v\":1,\"sid\":41207,\"id\":34,\"ts_ms\":100,\"type\":\"play_motion\",\"payload\":{\"name\":\"nod\",\"speed\":\"fast\",\"repeat\":1}}\n",
      "expect_error": "invalid_payload",
      "note": "`speed`は数である。"
    },
    {
      "name": "play_motion_repeat_negative",
      "line": "{\"v\":1,\"sid\":41207,\"id\":35,\"ts_ms\":100,\"type\":\"play_motion\",\"payload\":{\"name\":\"nod\",\"speed\":0.45,\"repeat\":-1}}\n",
      "expect_error": "invalid_payload",
      "note": "`repeat`はu32である（§3）。負数は幅に収まらない。"
    },
    {
      "name": "play_motion_repeat_over_u32",
      "line": "{\"v\":1,\"sid\":41207,\"id\":36,\"ts_ms\":100,\"type\":\"play_motion\",\"payload\":{\"name\":\"nod\",\"speed\":0.45,\"repeat\":4294967296}}\n",
      "expect_error": "invalid_payload",
      "note": "`repeat`はu32である（§3）。u32の最大値を1超える値は幅に収まらない。"
    },
    {
      "name": "play_motion_repeat_fractional",
      "line": "{\"v\":1,\"sid\":41207,\"id\":37,\"ts_ms\":100,\"type\":\"play_motion\",\"payload\":{\"name\":\"nod\",\"speed\":0.45,\"repeat\":1.5}}\n",
      "expect_error": "invalid_payload",
      "note": "`repeat`は整数である（§3）。"
    },
    {
      "name": "play_motion_name_not_a_string",
      "line": "{\"v\":1,\"sid\":41207,\"id\":38,\"ts_ms\":100,\"type\":\"play_motion\",\"payload\":{\"name\":7,\"speed\":0.45,\"repeat\":1}}\n",
      "expect_error": "invalid_payload",
      "note": "`name`はstringである（§3）。"
    },
    {
      "name": "unsupported_version_takes_precedence_over_unknown_type",
      "line": "{\"v\":2,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"no_such_type\",\"payload\":{}}\n",
      "expect_error": "unsupported_version",
      "note": "§5.1の手順2（version）が手順3（type固有schema）より先である証拠。順序を入れ替えるとunknown_typeになる。"
    },
    {
      "name": "hello_reason_not_in_enum",
      "line": "{\"v\":1,\"sid\":90312,\"id\":1,\"ts_ms\":40,\"type\":\"hello\",\"payload\":{\"host\":\"deskcatd\",\"version\":\"0.1.0\",\"reason\":\"reboot\"}}\n",
      "expect_error": "invalid_payload",
      "note": "§12: payloadが不正な`hello`（`reason`が列挙外）はinvalid_payload。"
    },
    {
      "name": "hello_missing_reason",
      "line": "{\"v\":1,\"sid\":90312,\"id\":1,\"ts_ms\":40,\"type\":\"hello\",\"payload\":{\"host\":\"deskcatd\",\"version\":\"0.1.0\"}}\n",
      "expect_error": "invalid_payload"
    },
    {
      "name": "boot_missing_board",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"boot\",\"payload\":{\"firmware\":\"0.1.0\",\"reset_reason\":\"power_on\"}}\n",
      "expect_error": "invalid_payload"
    },
    {
      "name": "boot_firmware_wrong_type",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"boot\",\"payload\":{\"firmware\":1,\"board\":\"esp32\",\"reset_reason\":\"power_on\"}}\n",
      "expect_error": "invalid_payload"
    },
    {
      "name": "ack_rejected_without_code",
      "line": "{\"v\":1,\"sid\":41207,\"id\":905,\"ts_ms\":53100,\"type\":\"ack\",\"payload\":{\"reply_sid\":90312,\"reply_to\":903,\"status\":\"rejected\"}}\n",
      "expect_error": "invalid_payload",
      "note": "§6: rejectedの場合はmachine-readableなcodeを含める。"
    },
    {
      "name": "boot_firmware_over_limit",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"boot\",\"payload\":{\"firmware\":\"fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\",\"board\":\"esp32\",\"reset_reason\":\"power_on\"}}\n",
      "expect_error": "out_of_range",
      "note": "上限+1 byte。上限ちょうどはvalid側のstrings_at_limitにある。"
    },
    {
      "name": "multibyte_string_over_limit_but_under_char_count",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"boot\",\"payload\":{\"firmware\":\"ああああああああああああああああああああああ\",\"board\":\"esp32\",\"reset_reason\":\"power_on\"}}\n",
      "expect_error": "out_of_range",
      "note": "上限をbyte数ではなく文字数で数える実装を検出する。66 byteで上限超過だが、22文字なので文字数では通ってしまう。"
    },
    {
      "name": "hello_host_over_limit",
      "line": "{\"v\":1,\"sid\":90312,\"id\":1,\"ts_ms\":40,\"type\":\"hello\",\"payload\":{\"host\":\"hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh\",\"version\":\"0.1.0\",\"reason\":\"startup\"}}\n",
      "expect_error": "out_of_range"
    },
    {
      "name": "ack_detail_over_limit",
      "line": "{\"v\":1,\"sid\":41207,\"id\":905,\"ts_ms\":53100,\"type\":\"ack\",\"payload\":{\"reply_sid\":90312,\"reply_to\":903,\"status\":\"rejected\",\"code\":\"busy\",\"detail\":\"ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\"}}\n",
      "expect_error": "out_of_range"
    },
    {
      "name": "line_one_byte_over_maximum",
      "line": "{\"v\":1,\"sid\":41207,\"id\":1,\"ts_ms\":100,\"type\":\"boot\",\"payload\":{\"firmware\":\"0.1.0\",\"board\":\"esp32\",\"reset_reason\":\"power_on\",\"unknown_pad\":\"\"}}\n",
      "expect_error": "line_too_long",
      "note": "改行を含めて1025 byte。"
    },
    {
      "name": "set_expression_name_not_in_enum",
      "line": "{\"v\":1,\"sid\":90312,\"id\":901,\"ts_ms\":52000,\"type\":\"set_expression\",\"payload\":{\"name\":\"sleepy\",\"transition_ms\":300}}\n",
      "expect_error": "invalid_payload",
      "note": "§5.2の初期名に無い名前。§7の表の「列挙外の値」。"
    },
    {
      "name": "set_expression_missing_transition_ms",
      "line": "{\"v\":1,\"sid\":90312,\"id\":901,\"ts_ms\":52000,\"type\":\"set_expression\",\"payload\":{\"name\":\"happy\"}}\n",
      "expect_error": "invalid_payload"
    },
    {
      "name": "show_text_over_byte_limit",
      "line": "{\"v\":1,\"sid\":90312,\"id\":903,\"ts_ms\":52300,\"type\":\"show_text\",\"payload\":{\"text\":\"ありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありがとありxxx\",\"duration_ms\":5000}}\n",
      "expect_error": "out_of_range",
      "note": "textがMAX_TEXT_BYTES＋1 byte（885 byte）。対はvalid.jsonのshow_text_at_byte_limit。"
    },
    {
      "name": "show_text_control_character_newline",
      "line": "{\"v\":1,\"sid\":90312,\"id\":903,\"ts_ms\":52300,\"type\":\"show_text\",\"payload\":{\"text\":\"なでて\\nくれた\",\"duration_ms\":5000}}\n",
      "expect_error": "out_of_range",
      "note": "制御文字（Unicodeの一般カテゴリCc）は1文字も許さない（§7）。改行も含む。"
    },
    {
      "name": "show_text_control_character_delete",
      "line": "{\"v\":1,\"sid\":90312,\"id\":903,\"ts_ms\":52300,\"type\":\"show_text\",\"payload\":{\"text\":\"a\\u007fb\",\"duration_ms\":5000}}\n",
      "expect_error": "out_of_range",
      "note": "C0の範囲外の制御文字（U+007F）も拒否する（§7）。"
    },
    {
      "name": "show_text_negative_duration",
      "line": "{\"v\":1,\"sid\":90312,\"id\":903,\"ts_ms\":52300,\"type\":\"show_text\",\"payload\":{\"text\":\"hi\",\"duration_ms\":-1}}\n",
      "expect_error": "invalid_payload",
      "note": "duration_msはu32である（§3のpayloadの数値の幅）。負数は幅に収まらないためinvalid_payloadとする。"
    },
    {
      "name": "head_touched_missing_duration_ms",
      "line": "{\"v\":1,\"sid\":41207,\"id\":22,\"ts_ms\":8400,\"type\":\"head_touched\",\"payload\":{\"strength\":0.68}}\n",
      "expect_error": "invalid_payload",
      "note": "strengthだけではduration_msの欠落を補わない。"
    },
    {
      "name": "lifted_duration_ms_wrong_type",
      "line": "{\"v\":1,\"sid\":41207,\"id\":24,\"ts_ms\":11000,\"type\":\"lifted\",\"payload\":{\"duration_ms\":\"1200\"}}\n",
      "expect_error": "invalid_payload"
    },
    {
      "name": "environment_value_not_finite_as_f32",
      "line": "{\"v\":1,\"sid\":41207,\"id\":25,\"ts_ms\":15000,\"type\":\"environment\",\"payload\":{\"temperature_c\":1e39}}\n",
      "expect_error": "invalid_payload",
      "note": "environmentの測定量は有限の32-bit浮動小数点数である（§3）。JSONはNaNと無限大を書けないが、32-bitへ狭めた結果が有限でない数（例: 1e39）はinvalid_payloadとする。"
    },
    {
      "name": "environment_value_wrong_type",
      "line": "{\"v\":1,\"sid\":41207,\"id\":25,\"ts_ms\":15000,\"type\":\"environment\",\"payload\":{\"humidity_pct\":\"55.1\"}}\n",
      "expect_error": "invalid_payload"
    }
  ]
}
