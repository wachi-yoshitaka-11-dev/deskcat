# port と baud を除く値は、すべて暫定である。根拠は無い。
# Pi実機で、Piの起動で始まり、ESP32とつながらない間は再起動して約4分でfailedになり、reset-failedとrestartでactiveになった。ESP32のACKは届いたが、deskcatdは未承認のsessionとしてWARNを出した。activeはsessionの確立を示さない（2026-10-12。docs/hardware/experiment-log.mdのEXP-024）。
# PiとESP32を同時に入れて自動でつながることは、確かめていない。
# 終了コードと値の意味は、`apps/deskcatd/src/main.rs`と`apps/deskcatd/src/daemon.rs`のmodule docを参照する。

[Unit]
Description=DeskCat Raspberry Pi service (deskcatd)
# 暫定。根拠なし（`PROTO-TBD-011`）。
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=simple
User=deskcatd
Group=deskcatd
SupplementaryGroups=dialout
NoNewPrivileges=yes
LimitCORE=0
UMask=0077
# systemdがroot-only sourceからサービス専用のread-only credentialへコピーする。
# fileが無いときはSetCredential=の値が既定値になり、serviceは起動する（クラウドはoff）。
# 既定値はキーではない印で、deskcatdはこの値をキーとして使わない（`apps/deskcatd/src/cloud_speech.rs`の`NO_KEY_MARKER`）。
# 値を空にしない。systemd 257.9は空の値を"Invalid syntax"として捨て、fileが無いと243/CREDENTIALSで起動しない（#522）。
LoadCredential=anthropic-api-key:/etc/deskcatd/anthropic-api-key
SetCredential=anthropic-api-key:deskcatd-no-api-key
StateDirectory=deskcatd
StateDirectoryMode=0700
# port と baud は未確認の値なので、ここに書かない（baud: `PROTO-TBD-001`）。
EnvironmentFile=/etc/deskcatd/deskcatd.env
# 起動の期限: 暫定。根拠なし。duplicate履歴: 暫定。根拠なし（`PROTO-TBD-005`）。
ExecStart=/usr/local/bin/deskcatd \
    --port ${DESKCATD_PORT} \
    --baud ${DESKCATD_BAUD} \
    --duplicate-capacity 8 \
    --duplicate-retention-ms 5000 \
    --startup-deadline-ms 10000
Restart=on-failure
# 1は再起動しない。
RestartPreventExitStatus=1
# 暫定。根拠なし。
RestartSec=3s

[Install]
WantedBy=multi-user.target
